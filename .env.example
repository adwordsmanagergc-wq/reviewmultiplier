# Contact form email delivery (optional).
# If unset, the /api/contact endpoint still accepts submissions and returns
# success (logging them to the function logs) but does not send email.
#
# Set these in the Vercel dashboard under Project Settings > Environment Variables.

# Resend API key (https://resend.com). Enables email delivery of enquiries.
RESEND_API_KEY=

# Where contact enquiries are sent.
CONTACT_TO_EMAIL=sales@metatap.io

# Verified Resend sender address. Use onboarding@resend.dev for testing,
# or a domain you've verified in Resend for production.
CONTACT_FROM_EMAIL=onboarding@resend.dev
